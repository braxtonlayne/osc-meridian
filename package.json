{
  "name": "osc-meridian",
  "private": true,
  "version": "4.1.7",
  "description": "MERIDIAN Workstation Environment: a work of fiction. A static, browser-based fictional government intranet.",
  "type": "module",
  "scripts": {
    "canon": "tsx scripts/canon-merge.ts",
    "content": "tsx scripts/build-content.ts",
    "dev": "npm run canon && npm run content && vite",
    "build": "npm run canon && npm run content && tsc --noEmit && vite build && tsx scripts/prerender.ts && tsx scripts/verify-dist.ts",
    "build:pages": "cross-env MERIDIAN_BASE=/osc-meridian/ npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:dist",
    "test:unit": "vitest run",
    "test:dist": "tsx scripts/verify-dist.ts",
    "test:e2e": "playwright test",
    "rehearse": "npm run build:pages && tsx scripts/rehearse-pages.ts"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@preact/signals": "^2.11.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-hierarchy": "^3.1.3",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "idb-keyval": "^6.3.0",
    "minisearch": "^7.2.0",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "uplot": "^1.6.32",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^21.0.4",
    "hast-util-to-string": "^3.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
