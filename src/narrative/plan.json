{
  "version": 1,
  "note": "SPOILER MATERIAL. Narrative/unlock plan for the integration phase (src/narrative). Never import into content/ or show in-site. Human version: docs/NARRATIVE.md.",
  "baseline": {
    "tier": 3,
    "compartments": [
      "LANTERN"
    ],
    "flags": [],
    "actingTier2": false,
    "workstation": "A03-5-114"
  },
  "keys": {
    "rule": "Release key = T<tier> | <COMPARTMENT> | <COMPARTMENT>+T<tier>. T1 keys never ship. T2 is satisfied only by ACTING-T2. <COMP>+T2 needs both.",
    "compartments": [
      "KESTREL",
      "HOLLOW",
      "SEXTANT",
      "TALLOW",
      "BRIAR",
      "QUARRY",
      "LANTERN"
    ]
  },
  "steps": [
    {
      "id": "S01",
      "title": "Orientation: read the briefing directive",
      "trigger": {
        "type": "doc.read",
        "docNos": [
          "OSC-DIR-0412"
        ],
        "mode": "any"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "oriented"
      },
      "mail": "msg-08-04470",
      "releases": [],
      "breadcrumbs": [
        {
          "page": "msg-08-04102",
          "hint": "Okafor asks the probationer to read DIR-0412 first."
        },
        {
          "page": "kb-0001",
          "hint": "Refusals cite DIR-0412."
        }
      ]
    },
    {
      "id": "S02",
      "title": "Find the held accession",
      "trigger": {
        "type": "anyOf",
        "of": [
          {
            "type": "doc.read",
            "docNos": [
              "OIA-08-031"
            ]
          },
          {
            "type": "search",
            "pattern": "RD-ACC-08-00412|\\b00412\\b|OIA-08-031"
          }
        ]
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "accessionHeld"
      },
      "mail": null,
      "releases": [
        {
          "key": "flag:accessionHeld",
          "pages": [
            "assurance-oia-08-031"
          ],
          "what": "Access log section begins listing the visitor's own accesses (filled from audit)."
        }
      ],
      "breadcrumbs": [
        {
          "page": "msg-08-04470",
          "hint": "Tasking lists RD-ACC-08-00412 as HELD (OIA-08-031)."
        }
      ]
    },
    {
      "id": "S03",
      "title": "Open the scanned Facility Inventory",
      "trigger": {
        "type": "doc.read",
        "docNos": [
          "OSC-2008-Q2"
        ],
        "mode": "any"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "scanRead"
      },
      "mail": "msg-08-04490",
      "releases": [],
      "breadcrumbs": [
        {
          "page": "assurance-oia-08-031",
          "hint": "Ticket cross-references OSC-2008-Q2 and says it stays on the index so access can be recorded."
        },
        {
          "page": "council-composition",
          "hint": "Copy register cites the inventory."
        }
      ]
    },
    {
      "id": "S04",
      "title": "Self-report the access (BRIAR)",
      "trigger": {
        "type": "form.submit",
        "form": "OSC-F-160",
        "match": {
          "documentInvolved": "OSC-2008-Q2|RD-ACC-08-00412"
        }
      },
      "requires": [
        "S03"
      ],
      "grant": {
        "kind": "compartment",
        "value": "BRIAR"
      },
      "mail": "msg-08-04480",
      "releases": [
        {
          "key": "BRIAR",
          "pages": [
            "assurance-oia-08-031"
          ],
          "what": "Inquiry log: custody chain from a Secretariat registry at ALPHA-01; \"first opened from workstation A03-5-114, 27 MAR 2008\"; \"title sheet copy number partially legible: 07\"."
        },
        {
          "key": "BRIAR",
          "pages": [
            "council-inventory-scan"
          ],
          "what": "Second digit of \"COPY 0_ OF 11\" (7)."
        },
        {
          "key": "BRIAR",
          "pages": [
            "assurance-threat-04",
            "assurance-threat-06"
          ],
          "what": "Later contingency paragraphs; THR-06 disposition line (\"recorded in personnel accounting as a change of category\")."
        },
        {
          "key": "BRIAR",
          "pages": [
            "assurance-psec",
            "personnel-vetting",
            "dir-0378"
          ],
          "what": "Monitoring methods, re-investigation triggers, inquiry dispositions."
        }
      ],
      "breadcrumbs": [
        {
          "page": "msg-08-04490",
          "hint": "OIA access message: self-reports under DIR-0378 are considered in mitigation."
        },
        {
          "page": "dir-0378",
          "hint": "OSC-F-160 named as the self-report form."
        }
      ]
    },
    {
      "id": "S05",
      "title": "Read the 790 query and its closure",
      "trigger": {
        "type": "doc.read",
        "docNos": [
          "OSC-MEM-08-0187",
          "OSC-MEM-08-0203"
        ],
        "mode": "all"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "queryRead"
      },
      "mail": null,
      "releases": [
        {
          "key": "flag:queryRead",
          "pages": [
            "f-131"
          ],
          "what": "Form shows the receipt history line \"Declarations this period: N\" (still no instructions)."
        }
      ],
      "breadcrumbs": [
        {
          "page": "personnel-overview",
          "hint": "DETACHED / UNPOSTED 790 row, no drill-down, footnote to DIR-0233."
        },
        {
          "page": "dir-0233",
          "hint": "Para 6 \"[Reserved.]\"; para 9 on PV-Q queries."
        },
        {
          "page": "system-glossary",
          "hint": "DETACHED / UNPOSTED -> PERSONNEL ACCOUNTING loop."
        }
      ]
    },
    {
      "id": "S06",
      "title": "File an unposted status declaration (HOLLOW)",
      "trigger": {
        "type": "form.submit",
        "form": "OSC-F-131",
        "match": {
          "anyField": "^\\s*790\\s*$|P-3-06-0977|P-4-07-0219|P-3-05-0142"
        }
      },
      "requires": [],
      "grant": {
        "kind": "compartment",
        "value": "HOLLOW"
      },
      "mail": "msg-08-04481",
      "releases": [
        {
          "key": "HOLLOW",
          "pages": [
            "personnel-directory"
          ],
          "what": "Fields of Ackroyd, Dimmick, Tobin; Dimmick \"Workstation A03-5-114 reassigned 14 APR 2008\"."
        },
        {
          "key": "HOLLOW",
          "pages": [
            "personnel-mem-08-0187"
          ],
          "what": "Attachment A: three PN lines (the other 787 are Tier 1)."
        },
        {
          "key": "HOLLOW",
          "pages": [
            "personnel-mem-08-0203"
          ],
          "what": "cc line to the Resident Assurance Officer."
        },
        {
          "key": "HOLLOW",
          "pages": [
            "personnel-overview",
            "fac-beta-08"
          ],
          "what": "Declarations count footnote; BETA-08 vacated analyst post."
        },
        {
          "key": "HOLLOW+KESTREL",
          "pages": [
            "transit-seg-04"
          ],
          "what": "Beside R. Tobin on the crew list: \"status changed 19 APR 2007\"."
        }
      ],
      "breadcrumbs": [
        {
          "page": "personnel-mem-08-0187",
          "hint": "Kessler notes F-131 declarations arriving without instructions."
        },
        {
          "page": "system-calendar",
          "hint": "27 MAY: Unposted status declarations, collection closes."
        },
        {
          "page": "f-131",
          "hint": "The form itself, empty instructions block."
        }
      ]
    },
    {
      "id": "S07",
      "title": "Read the annotated mileage memo",
      "trigger": {
        "type": "doc.read",
        "docNos": [
          "OSC-MEM-07-0944"
        ],
        "mode": "any"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "mileageQuery"
      },
      "mail": null,
      "releases": [],
      "breadcrumbs": [
        {
          "page": "ledger-cat-transit",
          "hint": "Cost-per-mile table, footnote to OSC-MEM-07-0944."
        },
        {
          "page": "transit-engineering",
          "hint": "Certified mileage not derived from this table."
        },
        {
          "page": "system-glossary",
          "hint": "CERTIFIED MILEAGE vs ENGINEERING MILEAGE."
        }
      ]
    },
    {
      "id": "S08",
      "title": "Request KESTREL with a sponsor",
      "trigger": {
        "type": "form.submit",
        "form": "OSC-F-126",
        "match": {
          "compartment": "^KESTREL$",
          "sponsorPn": "^(P-2-02-0091|P-3-05-0288|P-3-06-0866|P-3-07-0901)$",
          "justification": "OSC-MEM-07-0944|OSC-TRN-ENG|OSC-TRN-SEG-0[1-6]|OSC-TRN-INC-08-017|OSC-TRN-POS-08-044|OSC-TRN-RS"
        }
      },
      "requires": [
        "S07"
      ],
      "grant": {
        "kind": "compartment",
        "value": "KESTREL"
      },
      "mail": "msg-08-04482",
      "releases": [
        {
          "key": "KESTREL",
          "pages": [
            "transit-seg-04"
          ],
          "what": "Commissioning crew list (R. Tobin) and walk-down schedule."
        },
        {
          "key": "KESTREL",
          "pages": [
            "transit-engineering"
          ],
          "what": "Environmental table: segment 04 portal readings consistent with occupancy 13 MAY 2100Z-2300Z, annotated \"possession\"."
        },
        {
          "key": "KESTREL",
          "pages": [
            "transit-incident-08-017"
          ],
          "what": "Albright remarks: first occasion 08 APR not logged; possession masks detection."
        },
        {
          "key": "KESTREL",
          "pages": [
            "transit-possession-08-044"
          ],
          "what": "Party FE 2, SFC escort 4."
        },
        {
          "key": "KESTREL",
          "pages": [
            "transit-rolling-stock"
          ],
          "what": "Whole page opens (was a refusal); R04-001/002 stabled, not in service."
        },
        {
          "key": "KESTREL",
          "pages": [
            "transit-overview",
            "msg-08-04473",
            "ledger-mem-07-0944"
          ],
          "what": "R04-900..999 reserved to Transit Control; cable party details; portal notes."
        }
      ],
      "breadcrumbs": [
        {
          "page": "f-126",
          "hint": "Sponsor must hold the compartment; justification must cite a document in its scope."
        },
        {
          "page": "personnel-directory",
          "hint": "Holds column shows KESTREL holders."
        },
        {
          "page": "ledger-mem-07-0944",
          "hint": "Distribution lists KESTREL holders."
        }
      ]
    },
    {
      "id": "S09",
      "title": "Witness the segment 04 movement",
      "trigger": {
        "type": "transit.watch",
        "event": "SEG04"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "seg04Witnessed"
      },
      "mail": "msg-08-04493",
      "releases": [],
      "breadcrumbs": [
        {
          "page": "transit-overview",
          "hint": "Segment 04 row with no paths."
        },
        {
          "page": "kb-0042",
          "hint": "Suppressed consist IDs explained."
        },
        {
          "page": "system-calendar",
          "hint": "13 MAY possession with no times."
        }
      ]
    },
    {
      "id": "S10",
      "title": "Report the occupancy (SEXTANT)",
      "trigger": {
        "type": "form.submit",
        "form": "OSC-F-114",
        "match": {
          "location": "(seg(ment)?\\s*0?4\\b|\\b04-\\d{2}\\b|R04)"
        }
      },
      "requires": [],
      "requiresAny": [
        "S09",
        "S08"
      ],
      "grant": {
        "kind": "compartment",
        "value": "SEXTANT"
      },
      "mail": "msg-08-04483",
      "releases": [
        {
          "key": "SEXTANT",
          "pages": [
            "registry-index",
            "assurance-cov",
            "assurance-ctr"
          ],
          "what": "Anchor, cover, connections and site columns for every non-adjacent ALPHA/BETA/GAMMA row (DELTA stays T1)."
        },
        {
          "key": "SEXTANT",
          "pages": [
            "transit-net-eas",
            "transit-net-sou",
            "transit-net-mtw",
            "transit-seg-02"
          ],
          "what": "Link endpoints and labels."
        },
        {
          "key": "SEXTANT",
          "pages": [
            "fac-alpha-01",
            "fac-alpha-02",
            "fac-alpha-04",
            "fac-beta-03",
            "fac-beta-08"
          ],
          "what": "Dossier location and connection blocks (and the other BETA/GAMMA dossiers alike)."
        },
        {
          "key": "SEXTANT",
          "pages": [
            "reserves-rx-b03",
            "reserves-rx-b08",
            "reserves-rx-b09",
            "msg-08-04474"
          ],
          "what": "BETA reactor site identities."
        }
      ],
      "breadcrumbs": [
        {
          "page": "msg-08-04493",
          "hint": "OIA: irregular indications are to be reported on OSC-F-114."
        },
        {
          "page": "dir-0378",
          "hint": "\"including an indication observed on a MERIDIAN display\"."
        },
        {
          "page": "dir-0412",
          "hint": "Para 4(c): reporting officer read into the report's compartment."
        }
      ]
    },
    {
      "id": "S11",
      "title": "Look up the reactor work order (TALLOW)",
      "trigger": {
        "type": "terminal.cmd",
        "pattern": "^wo\\s+FE-08-0417\\s*$"
      },
      "requires": [
        "S01"
      ],
      "grant": {
        "kind": "compartment",
        "value": "TALLOW"
      },
      "mail": "msg-08-04484",
      "releases": [
        {
          "key": "TALLOW",
          "pages": [
            "reserves-rx-a01",
            "reserves-rx-a02",
            "reserves-rx-a03",
            "reserves-rx-a04",
            "reserves-rx-a05",
            "reserves-rx-b03",
            "reserves-rx-b08",
            "reserves-rx-b09"
          ],
          "what": "Fuel inventory, refuelling schedule, burn-down."
        },
        {
          "key": "TALLOW",
          "pages": [
            "reserves-energy",
            "reserves-overview",
            "reserves-food"
          ],
          "what": "BETA reactor sites named; site stocks."
        },
        {
          "key": "TALLOW",
          "pages": [
            "reserves-mem-07-0612"
          ],
          "what": "\"Reserve sufficiency is stated for designated persons only; berths above the sustained figure are not provisioned.\""
        }
      ],
      "breadcrumbs": [
        {
          "page": "reserves-rx-a03",
          "hint": "\"(lookup: wo FE-08-0417)\"."
        },
        {
          "page": "reserves-seed",
          "hint": "Cold room 2 constraint, same work order."
        },
        {
          "page": "kb-0031",
          "hint": "wo <number>; viewing may add you to its distribution."
        },
        {
          "page": "dir-0301",
          "hint": "Para 7: division lookup utilities not listed in help."
        }
      ]
    },
    {
      "id": "S12",
      "title": "Report the copy number (QUARRY)",
      "trigger": {
        "type": "form.submit",
        "form": "OSC-F-114",
        "match": {
          "documents": "OSC-2008-Q2",
          "anyField": "copy\\s*(no\\.?|number)?\\s*0?7\\b"
        }
      },
      "requires": [
        "S04"
      ],
      "grant": {
        "kind": "compartment",
        "value": "QUARRY"
      },
      "mail": "msg-08-04485",
      "releases": [
        {
          "key": "QUARRY",
          "pages": [
            "council-charter-iii",
            "council-charter-iv",
            "council-charter-vi"
          ],
          "what": "Gated articles open in full."
        },
        {
          "key": "QUARRY",
          "pages": [
            "council-composition",
            "council-seat-07"
          ],
          "what": "Copy register columns; seat 07 \"certificate of destruction: to follow (Secretariat)\"."
        },
        {
          "key": "QUARRY",
          "pages": [
            "council-minutes-06-04",
            "council-minutes-07-03",
            "council-minutes-07-06",
            "council-minutes-08-01",
            "council-minutes-08-02"
          ],
          "what": "Minute items, including MIN-08-02 payroll category change (count line T2)."
        }
      ],
      "breadcrumbs": [
        {
          "page": "msg-08-04480",
          "hint": "BRIAR briefing: further provenance information goes on OSC-F-114."
        },
        {
          "page": "council-seat-07",
          "hint": "Empty certificate field where every other succession has a number."
        },
        {
          "page": "council-charter-ii",
          "hint": "Predecessor copy destroyed before successor copy issued."
        }
      ]
    },
    {
      "id": "S13",
      "title": "Run the strength utility",
      "trigger": {
        "type": "terminal.cmd",
        "pattern": "^strength\\s+unposted\\s*$"
      },
      "requires": [
        "S06"
      ],
      "grant": {
        "kind": "flag",
        "value": "strengthRun"
      },
      "mail": "msg-08-04495",
      "releases": [
        {
          "key": "flag:strengthRun",
          "pages": [
            "system-calendar"
          ],
          "what": "Terminal prints category total 790, three released lines, 787 \"[NOT RELEASED]\", and \"Category change effective 31 MAY 2008: count withheld\"."
        }
      ],
      "breadcrumbs": [
        {
          "page": "personnel-mem-08-0187",
          "hint": "STRENGTH utility returns the category total without breakdown."
        },
        {
          "page": "dir-0301",
          "hint": "Para 7."
        }
      ]
    },
    {
      "id": "S14",
      "title": "Interim review offer",
      "trigger": {
        "type": "state",
        "condition": "count(compartments in [KESTREL,HOLLOW,SEXTANT,TALLOW,BRIAR,QUARRY]) >= 4"
      },
      "requires": [],
      "grant": {
        "kind": "flag",
        "value": "interimReview"
      },
      "mail": "msg-08-04486",
      "releases": [],
      "breadcrumbs": [
        {
          "page": "msg-08-04417",
          "hint": "Day-30 report mentions the interim review."
        },
        {
          "page": "personnel-transfer",
          "hint": "DIR-0395 para 3(b) exception."
        }
      ]
    },
    {
      "id": "S15",
      "title": "Acting Tier 2",
      "trigger": {
        "type": "anyOf",
        "of": [
          {
            "type": "form.submit",
            "form": "OSC-F-126",
            "match": {
              "compartment": "^ACTING-T2$",
              "sponsorPn": "^P-2-04-0218$"
            }
          },
          {
            "type": "terminal.cmd",
            "pattern": "^clearance\\s+request\\s+acting\\s*$"
          }
        ]
      },
      "requires": [
        "S14"
      ],
      "grant": {
        "kind": "acting",
        "value": "ACTING-T2"
      },
      "mail": "msg-08-04487",
      "releases": [
        {
          "key": "T2",
          "pages": [
            "*"
          ],
          "what": "Every T2 block network-wide (e.g. genetic vault donor categories, ALPHA function lines, ledger programme category column, minutes count line text \"count withheld\")."
        },
        {
          "key": "T2",
          "pages": [
            "reserves-arms"
          ],
          "what": "Whole-page refusal lifts."
        },
        {
          "key": "<COMP>+T2",
          "pages": [
            "*"
          ],
          "what": "Combined keys for compartments already held (e.g. QUARRY+T2 in MIN-08-02, KESTREL+T2 R04-9xx movement authority)."
        }
      ],
      "breadcrumbs": [
        {
          "page": "msg-08-04486",
          "hint": "Okafor: apply on OSC-F-126 under DIR-0395 para 7, sponsor P-2-04-0218."
        },
        {
          "page": "dir-0395",
          "hint": "Para 7: OSC-F-126 or \"clearance request acting\"."
        }
      ]
    }
  ],
