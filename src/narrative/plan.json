  "auditRules": [
    {
      "id": "A1",
      "kind": "doc.read",
      "condition": "docNo == OSC-2008-Q2 (first time per profile)",
      "effect": "Deliver msg-08-04490; append access line to OIA-08-031 access log; step S03."
    },
    {
      "id": "A2",
      "kind": "search",
      "condition": "second query this session matching /unposted|\\b790\\b|detached|seg(ment)?\\s*0?4|electronic cop|inventory scan|ackroyd|dimmick|tobin|copy\\s*0?7/i",
      "effect": "Deliver msg-08-04491 once per profile, quoting the second query."
    },
    {
      "id": "A3",
      "kind": "redaction.hover",
      "condition": ">= 25 hovers in one session",
      "effect": "Deliver msg-08-04492 once per profile with count and the most-hovered docNo."
    },
    {
      "id": "A4",
      "kind": "transit.watch",
      "condition": "board window visible (not minimized) at any moment of the SEG04 event",
      "effect": "Write the two segment 04 audit lines; step S09; deliver msg-08-04493."
    },
    {
      "id": "A5",
      "kind": "print",
      "condition": "print of any page marked UMBRA-C or higher, or form.submit OSC-F-142 naming a UMBRA-EO document",
      "effect": "Deliver msg-08-04494 once per profile; later cover sheets carry stamp REVIEWED-OIA."
    },
    {
      "id": "A6",
      "kind": "terminal.cmd",
      "condition": "command matches /^trace\\s+RD-ACC-08-00412/ or /^strength\\s+unposted/",
      "effect": "Deliver msg-08-04495 once per profile quoting the command."
    },
    {
      "id": "A7",
      "kind": "mail.send",
      "condition": "recipient in {l.ackroyd@b08.iad.mer, c.dimmick@a03.rd.mer, r.tobin@a02.fe.mer}",
      "effect": "Deliver msg-08-04497 (non-delivery) every time, recipient slot filled."
    },
    {
      "id": "A8",
      "kind": "mail.send",
      "condition": "recipient domain a01.pv.mer and body matches /790|unposted|PV-Q-08-0031/i",
      "effect": "Deliver msg-08-04496 once per profile (cc RAO)."
    },
    {
      "id": "A9",
      "kind": "window.open",
      "condition": "5th refusal (access-gated page) in one session",
      "effect": "notify(\"Repeated refusals are recorded (DIR-0412 para 8).\"); audit line only."
    },
    {
      "id": "A10",
      "kind": "form.submit",
      "condition": "OSC-F-122 by a probationer",
      "effect": "In-world refusal citing DIR-0247; audit line; no mail."
    },
    {
      "id": "A11",
      "kind": "timeout",
      "condition": "inactivity timeout",
      "effect": "Lock screen; audit line \"Session locked for inactivity\"; state preserved; the SEG04 event does not fire while locked."
    }
  ],
  "auditPhrasing": {
    "format": "AUD-{yymmdd}-{serial6} {hhmm}Z ({local}) {KIND} {operatorId} WS {workstation} {detail}",
    "examples": [
      "AUD-080520-004417 1432Z (1032 EDT) DOC.READ OPR-A03-1147 WS A03-5-114 Opened OSC-2008-Q2 (UMBRA//OSC EYES ONLY) in Records Library. Access recorded under OIA-08-031.",
      "AUD-080520-004418 1433Z (1033 EDT) REDACTION.HOVER OPR-A03-1147 WS A03-5-114 Examined withholding mark rx-14 in OSC-DIR-0233 (authority PV, ref PV-R-06)."
    ]
  },
  "segment04": {
    "timing": "Once per session (per login, not per profile): at login draw a uniform random delay of 6 to 25 minutes; the event fires then if the session is unlocked, else at unlock. It fires whether or not the board is open.",
    "duration": "Visible occupancy 150 s: blocks 04-01 to 04-12 occupied in sequence from the ALPHA-05 end (platform 7) toward ALPHA-02, about 12.5 s per block, two adjacent blocks lit at once.",
    "board": "Schematic and geographic views draw segment 04 dashed as always; the occupied blocks render solid for the duration. Consist label \"R04-***\" (format R04-NNN, true series R04-900..999 never displayed); headway and speed fields show \"--\". Timetable column: \"UNBOOKED\". Notification area link state for ALPHA-05 shows BUSY.",
    "incidentLog": "While occupied, the live incident log shows \"{hhmm}Z ({local}) SEG 04 BLK 04-{nn} OCCUPIED CONSIST R04-*** NO BOOKING\". 60 s after the last block clears, the entry is removed; the next log entry skips one serial, leaving a gap like INC-08-016 in the 08-017 extract.",
    "audit": [
      "AUD-{yymmdd}-{serial} {hhmm}Z ({local}) TRANSIT.WATCH OPR-A03-1147 WS A03-5-114 Network Control board displayed ({view}) {start}Z to {end}Z. Indications displayed: SEG 04 BLK 04-01 to 04-12.",
      "AUD-{yymmdd}-{serial+1} {hhmm}Z ({local}) SYSTEM Board indication record for interval {start}Z to {end}Z withdrawn by Transit Control on instruction."
    ],
    "unwatched": "If no transit window was visible, only the SYSTEM withdrawal line is written (the visitor can find it in audit tail), and no mail.",
    "followUp": "If watched: step S09 and msg-08-04493 after 8 to 12 minutes. The OIA message never mentions segment 04 by name; it says \"the Network Control board\".",
    "terminal": "During the event \"rail status\" prints \"SEG 04 NOT IN REVENUE SERVICE\" unchanged; \"consist R04-***\" or the true ID returns \"NO RECORD\"."
  },
  "terminalCommands": [
    {
      "command": "wo <workorder>",
      "example": "wo FE-08-0417",
      "output": "Work order status, location, distribution; for FE-08-0417 adds the workstation to the distribution and fires S11 (TALLOW). Other numbers (FE-07-0233, LR-08-0102) return dull closed jobs.",
      "mentionedIn": [
        "KB-0031",
        "OSC-RSV-RX-A03",
        "OSC-RSV-SEED",
        "OSC-DIR-0301"
      ]
    },
    {
      "command": "trace <accession>",
      "example": "trace RD-ACC-08-00412",
      "output": "Chain of custody: received Stacks C 24 MAR 2008 from a consignment of superseded registry media; origin hop SEXTANT/BRIAR; \"item HELD (OIA-08-031)\". Fires audit rule A6. Other accessions 00398-00415 trace to mundane origins.",
      "mentionedIn": [
        "OSC-DIR-0336",
        "MSG-08-04470"
      ]
    },
    {
      "command": "strength <site|unposted>",
      "example": "strength unposted",
      "output": "Site strength from returns; \"unposted\" prints the category total 790 (from canon) with no breakdown, then (HOLLOW) three lines and 787 \"[NOT RELEASED]\". Fires S13 and A6.",
      "mentionedIn": [
        "OSC-MEM-08-0187",
        "OSC-DIR-0301"
      ]
    },
    {
      "command": "consist <id>",
      "example": "consist R01-214",
      "output": "Consist record from the rolling stock register (KESTREL fields redacted without it). R04-*** or any R04-9xx returns \"NO RECORD\".",
      "mentionedIn": [
        "KB-0042",
        "OSC-TRN-RS"
      ]
    },
    {
      "command": "copies <docNo>",
      "example": "copies OSC-2008-Q2",
      "output": "Without QUARRY: refusal citing DIR-0412. With QUARRY: copy register 01-11 with seat 07 predecessor destruction \"TO FOLLOW\".",
      "mentionedIn": [
        "OSC-CNL-SEAT-00",
        "OSC-DIR-0354"
      ]
    },
    {
      "command": "clearance request acting",
      "example": "clearance request acting",
      "output": "Undocumented subcommand of the documented \"clearance\". Before S14: \"Not eligible: probationary (DIR-0247)\". After: fires S15.",
      "mentionedIn": [
        "OSC-DIR-0395"
      ]
    }
  ],
